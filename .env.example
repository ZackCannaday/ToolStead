# Runtime
NODE_ENV=development
HOST=0.0.0.0
PORT=3001
LOG_LEVEL=info
TRUST_PROXY=false

# PostgreSQL
DATABASE_URL=postgresql://toolstead:toolstead@127.0.0.1:5432/toolstead
DATABASE_SSL=false

# Supabase browser client
# The publishable key is intentionally safe for browser use; RLS still controls data access.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Authentication
# Production values must be unique random strings of at least 32 characters.
JWT_SECRET=replace-with-a-random-32-character-minimum-secret
COOKIE_SECRET=replace-with-a-different-random-32-character-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30

# Browser access
CORS_ORIGIN=http://localhost:5173

# Subscription records and module bundles exist, but enforcement remains disabled
# until the user intentionally enables billing in a later phase.
FEATURE_BILLING_ENFORCEMENT=false

# Legacy Node API bootstrap. Supabase Auth provisions new owners automatically.
OWNER_EMAIL=
OWNER_PASSWORD=
OWNER_NAME=
WORKSPACE_NAME=
