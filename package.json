{
  "name": "toolstead-priority-workbench",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,blue \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --env-file-if-exists=.env --watch server/index.js",
    "dev:web": "vite",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview",
    "start": "node --env-file-if-exists=.env server/index.js",
    "db:migrate": "node --env-file-if-exists=.env server/db/migrate.js",
    "db:bootstrap-owner": "node --env-file-if-exists=.env server/scripts/bootstrap-owner.js",
    "test": "node --test tests/*.test.mjs",
    "test:api": "node --test tests/api-foundation.test.mjs",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "verify": "npm run build && npm test"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/jwt": "^10.2.2",
    "@fastify/rate-limit": "^10.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@supabase/supabase-js": "2.112.4",
    "@vitejs/plugin-react": "5.0.4",
    "bcryptjs": "^3.0.3",
    "fastify": "^5.12.1",
    "pg": "^8.23.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "^6.4.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "concurrently": "^9.2.4"
  }
}
